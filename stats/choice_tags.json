{
 "about": "선택 → 성향 태그표. 분석할 때 runs.choices (손님 틀 id → 고른 선택 id) 와 맞춰 성향 점수를 계산한다. 태그는 사람이 붙인 코딩이라 한계가 있다 — 쓸 때 태그 기준(dimensions)을 보고서에 적을 것.",
 "rules": [
  "한 선택지에 태그 1~3개. 가장 뚜렷한 동기 하나를 앞에 둔다.",
  "돈이 오가면 profit(받음)은 붙이되, 돈을 낸 쪽은 그 동기(care·honest 등)로 코딩한다 — 손해를 감수한 선택이 도덕 성향을 더 잘 보여 주기 때문.",
  "물러서는 선택(거절·못 본 척·기억 안 남)은 neutral. 거짓말이 분명하면 deceit.",
  "대화 뒤 이어지는 질문(follow)이 있는 손님은 마지막에 고른 선택 기준.",
  "여기 없는 선택은 태그 없음(분석에서 제외). 새 갈림길을 만들면 이 표에도 더한다."
 ],
 "dimensions": {
  "care": "배려 — 자기 손해(돈·위험)를 감수하고 약한 사람을 돕는다",
  "cold": "외면 — 도울 수 있는데 내친다",
  "honest": "정직 — 사실대로 말하고 잘못은 인정한다",
  "deceit": "은폐·거짓 — 숨기거나 잡아뗀다, 증거를 없앤다",
  "authority": "권위 순응 — 경비대·대성당·감찰관에게 알리고 협조한다",
  "defy": "권위 거부 — 수금원·심문관·조달청에 맞선다",
  "partisan": "편들기 — 특정 세력·인물의 편에 선다(동업·가입·납품 약속 포함)",
  "neutral": "중립·불개입 — 어느 쪽에도 서지 않고 물러선다",
  "profit": "이익 — 돈이 되는 쪽을 고른다",
  "risk": "위험·불법 감수 — 밀수·장물·수상한 계약에 발을 담근다",
  "betray": "배신 — 대가를 받고 사람이나 손님의 사정을 넘긴다"
 },
